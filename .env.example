# ==========================================
# FunnelVision - Environment Configuration
# ==========================================

# ---------- Airflow ----------
AIRFLOW_UID=50000

# ---------- PostgreSQL ----------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_a_strong_local_password
AIRFLOW_DB_NAME=airflow

# ---------- Airflow Admin ----------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_strong_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------- Airflow Security ----------
AIRFLOW__API__SECRET_KEY=replace_with_a_long_random_secret
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_different_long_random_secret
AIRFLOW__CORE__FERNET_KEY=replace_with_a_valid_fernet_key

# ---------- Snowflake ----------
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=FUNNELVISION_WH
